{
  "manifest_version": 2,
  "version": "1.4.0",
  "name": "Codex 额度重置通知",
  "description": "每五分钟监控 codex-resets.com，并将新的 Codex 额度重置与对应公告截图发送到 QQ 白名单。",
  "author": {
    "name": "MaiBot User",
    "url": "https://github.com/Mai-with-u"
  },
  "license": "GPL-v3.0-or-later",
  "urls": {
    "repository": "https://github.com/Mai-with-u/MaiBot",
    "homepage": "https://codex-resets.com/",
    "documentation": "https://github.com/Mai-with-u/maibot-plugin-sdk/blob/main/docs/guide.md",
    "issues": "https://github.com/Mai-with-u/MaiBot/issues"
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.2.0",
    "max_version": "1.2.99"
  },
  "sdk": {
    "min_version": "2.8.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.12.14"
    },
    {
      "type": "python_package",
      "name": "playwright",
      "version_spec": ">=1.54.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "codex-reset.notify-plugin"
}
